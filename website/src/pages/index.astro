---
import BaseLayout from '../layouts/BaseLayout.astro';

// ====== INSTALL LINKS ======
// Sổ nhận xét - AI đã được Chrome Web Store phê duyệt (v1.4 ngày 17/05/2026).
// V1.5 (17/05/2026): bỏ Năng lực Khoa học cho lớp 1-3 (CT GDPT 2018).
const cwsUrl = 'https://chromewebstore.google.com/detail/sổ-nhận-xét-ai/hhiipgifeplegcejhpdmdbnbabjikllh';
const installGuideUrl = '/cai-dat';

// ====== VIDEO HƯỚNG DẪN ======
// Để bật video, thay `youtubeId: null` bằng ID YouTube thật (vd "dQw4w9WgXcQ")
// Lấy ID từ URL YouTube: https://youtu.be/<ID>  hoặc  https://www.youtube.com/watch?v=<ID>
const featuredVideo = {
  title: "Bắt đầu trong 90 giây — từ cài đặt đến nhận xét đầu tiên",
  description: "Video này dành cho thầy/cô lần đầu sử dụng. Xem 1 lần là làm được, không cần đọc tài liệu.",
  duration: "1:30",
  tag: "Bắt đầu nhanh",
  youtubeId: "GXprh9sotv0",
};

const videos = [
  {
    title: "Tạo nhận xét cho HS cả lớp bằng 1 nút chạm",
    duration: "2:15",
    tag: "Nhận xét môn",
    youtubeId: "sUTybnmawvM",
  },
  {
    title: "Tạo nhận xét Năng lực và Phẩm chất",
    duration: "3:00",
    tag: "Nhận xét NL/PC",
    youtubeId: "APakefrddc8",
  },
];

// ====== FEATURES ======
const features = [
  {
    icon: "📝",
    title: "Sinh nhận xét môn học",
    desc: "Hỗ trợ nhận xét theo từng môn/hoạt động: Tiếng Việt, Toán, Tự nhiên và Xã hội, Khoa học, Lịch sử và Địa lí, Đạo đức, Tin học, Tiếng Anh, GDTC, Âm nhạc, Mĩ thuật, Hoạt động trải nghiệm. Nội dung đa dạng, hạn chế trùng lặp.",
    accent: "#2B4F9E",
    accentBg: "#E6EBF5"
  },
  {
    icon: "🎯",
    title: "Gợi ý nhận xét NL-PC",
    desc: "Tự động gợi ý nhận xét Năng lực, Phẩm chất dựa trên kết quả học tập và rèn luyện. Giáo viên có thể chọn, chỉnh sửa hoặc thay đổi mức nhận xét khi cần.",
    accent: "#B8860B",
    accentBg: "#FFF8DC"
  },
  {
    icon: "⚡",
    title: "Áp dụng nhanh vào Vnedu",
    desc: "Xem trước toàn bộ nhận xét trong sidebar. Khi đồng ý, bấm “Áp dụng” để đưa nhận xét vào ô tương ứng trên Vnedu. Giáo viên kiểm tra lại và bấm Lưu.",
    accent: "#EA580C",
    accentBg: "#FFEDD5"
  },
  {
    icon: "📐",
    title: "Bám sát Thông tư 27",
    desc: "Gợi ý nhận xét theo tinh thần TT27/2020/TT-BGDĐT: rõ mức độ đạt được, dùng từ phù hợp lứa tuổi, giáo viên có thể chỉnh sửa trước khi lưu.",
    accent: "#7C3AED",
    accentBg: "#EDE9FE"
  },
  {
    icon: "🌐",
    title: "Chạy trực tiếp trên trình duyệt",
    desc: "Sau khi cài đặt, tiện ích hoạt động ngay trên Vnedu, không cần mở thêm phần mềm. Thao tác gọn, nhanh, phù hợp với công việc cuối kỳ.",
    accent: "#0891B2",
    accentBg: "#CFFAFE"
  },
  {
    icon: "🔄",
    title: "Cập nhật thường xuyên",
    desc: "Khi Vnedu thay đổi giao diện hoặc có mẫu nhận xét mới, tiện ích được cập nhật qua Chrome Web Store. Giáo viên chỉ cần sử dụng phiên bản mới nhất.",
    accent: "#059669",
    accentBg: "#D1FAE5"
  }
];

// ====== FAQ ======
const faqs = [
  {
    q: "Cài đặt có mất thời gian không? Tôi không rành công nghệ.",
    a: "Rất đơn giản — chỉ 30 giây. Bấm nút “Cài cho Chrome”, trang Chrome Web Store sẽ mở ra, bấm tiếp “Thêm vào Chrome” → “Thêm tiện ích”. Xong! Mở Vnedu là dùng được ngay. Có thể gọi/Zalo 0913031073 nếu cần hỗ trợ trực tiếp."
  },
  {
    q: "Dữ liệu học sinh của tôi có bị gửi đi đâu không?",
    a: "Không. Tuyệt đối không. Tên HS, điểm số, đánh giá — tất cả chỉ tồn tại trong trình duyệt của thầy/cô và biến mất khi đóng tab. Extension không có server, không có database lưu thông tin HS. Chỉ 3 thông tin của riêng GV (SĐT, mã kích hoạt, hash máy) rời máy — chỉ để xác thực thanh toán license."
  },
  {
    q: "Trường tôi dùng Vnedu phiên bản mới, có dùng được không?",
    a: "Có. Extension đang hỗ trợ Vnedu v5 (phiên bản hiện hành tính đến 2026). Nếu Vnedu cập nhật giao diện làm extension không nhận diện được module, bấm nút “Quét lại” trong sidebar. Nếu vẫn không được, gửi screenshot Console cho tác giả qua Zalo — thường update trong 1-2 ngày."
  },
  {
    q: "Đổi máy / cài lại Windows thì sao? Có phải mua mã mới không?",
    a: "Không. Nhắn Zalo cho admin, gửi SĐT đã đăng ký, admin sẽ reset thiết bị trong vài phút. Dùng lại mã cũ trên máy mới, không tốn thêm phí. Mã có giá trị 1 năm kể từ ngày kích hoạt."
  },
  {
    q: "Tôi có thể chia sẻ mã cho đồng nghiệp không?",
    a: "Mỗi mã chỉ kích hoạt được trên 1 máy tại 1 thời điểm. Nếu phát hiện chia sẻ (cùng mã đăng nhập trên nhiều máy khác nhau liên tục), mã sẽ bị khoá. Đồng nghiệp muốn dùng vui lòng đăng ký mã riêng — chi phí rất hợp lý so với hàng chục giờ ngồi viết nhận xét bằng tay."
  },
  {
    q: "Giáo viên có sửa được lời nhận xét đã sinh không?",
    a: "Hoàn toàn được — và đây là tinh thần thiết kế cốt lõi: AI lo phần lặp lại nặng nhọc, GV nắm quyền quyết định cuối cùng. Có 2 cách sửa: (1) Ngay trong sidebar trước khi áp dụng — click vào nhận xét bất kỳ để chỉnh từ ngữ, độ dài, hoặc thêm chi tiết riêng cho từng HS; (2) Sau khi đã áp dụng vào Vnedu — sửa trực tiếp trong textarea Vnedu như bình thường rồi bấm Lưu. Mọi chỉnh sửa của GV được ưu tiên tuyệt đối."
  },
  {
    q: "Nếu Chrome update lớn làm extension không chạy thì sao?",
    a: "Extension dùng Manifest V3 (chuẩn hiện hành của Chrome), tương thích lâu dài. Khi Chrome có thay đổi đột ngột, bản update mới sẽ được đẩy qua Chrome Web Store trong vòng vài ngày, GV không cần làm gì."
  }
];
---

<BaseLayout title="Sổ nhận xét - AI · Trợ lý sinh nhận xét cuối kỳ cho GV tiểu học">

  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Cho giáo viên tiểu học · Vnedu</span>
        <h1 class="text-balance">
          Nhận xét cuối kỳ cho <span class="highlight">cả lớp</span><br />
          xong trong <span class="underline-gold">5 phút</span>
        </h1>
        <p class="hero-sub text-pretty">
          Sổ nhận xét - AI tự động đọc bảng điểm Vnedu (GKI, CKI, GKII và đặc biệt là cuối năm) để có nhận xét theo Thông tư 27/2020 cho cả lớp. Nội dung lời nhận xét được AI xây dựng bảo đảm văn phong chuẩn mực, phù hợp môi trường sư phạm tiểu học và đúng định hướng đánh giá theo Thông tư 27/2020/TT-BGD&amp;ĐT.
        </p>
        <div class="hero-cta">
          <a href={cwsUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            <span style="font-size: 18px;">⬇</span>
            Cài đặt cho Chrome
          </a>
          <a href={installGuideUrl} class="btn btn-ghost btn-lg">
            📖 Xem hướng dẫn
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="float-card float-card-1">
          <div class="icon">✓</div>
          <div>
            <div class="label">Tất cả học sinh</div>
            <div class="sub">đã được nhận xét trong 1 lần chạm!</div>
          </div>
        </div>

        <div class="hero-video-frame">
          <div class="hero-video-bar">
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <div class="hero-video-bar-label">
              <span class="hero-video-play">▶</span>
              Video hướng dẫn · {featuredVideo.duration}
            </div>
          </div>
          <div class="video-player hero-video-player">
            {featuredVideo.youtubeId ? (
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${featuredVideo.youtubeId}?rel=0&modestbranding=1`}
                title={featuredVideo.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            ) : (
              <div class="video-placeholder">
                <div class="video-play-icon">▶</div>
                <div class="video-placeholder-text">Video sẽ được đăng tại đây</div>
              </div>
            )}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============== PILLARS (4 cards icon) ============== -->
  <section class="stats-strip pillars-section">
    <div class="container">
      <div class="pillar-grid">
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="16" cy="17" r="11" stroke="currentColor" stroke-width="1.8"/>
              <path d="M16 11v6l4 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M11 5l-3 2M21 5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pillar-title">5 phút</div>
          <div class="pillar-sub">hoàn thành nhận xét cả lớp</div>
          <span class="pillar-divider"></span>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="8" y="9" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 14h8M12 17h8M12 20h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M11 5v4M16 5v4M21 5v4M11 25v4M16 25v4M21 25v4M5 11h4M5 16h4M5 21h4M25 11h4M25 16h4M25 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="pillar-title">AI tự động</div>
          <div class="pillar-sub">phân tích kết quả học sinh</div>
          <span class="pillar-divider"></span>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M16 4l10 4v8c0 6-4.5 10.5-10 12-5.5-1.5-10-6-10-12V8l10-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M11 16l3.5 3.5L21 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="pillar-title">Theo TT27</div>
          <div class="pillar-sub">phù hợp đánh giá tiểu học</div>
          <span class="pillar-divider"></span>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="14" cy="11" r="4.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="M5 27c0-4.5 4-8 9-8 2 0 3.8.55 5.3 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M19 24l6.5-6.5 2.5 2.5L21.5 26.5 18 27l1-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="pillar-title">Giáo viên toàn quyền</div>
          <div class="pillar-sub">chỉnh sửa trước khi lưu</div>
          <span class="pillar-divider"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== PROBLEM ============== -->
  <section class="section-canvas">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Vấn đề</span>
        <h2 class="text-balance">Mỗi cuối học kỳ, thầy/cô đối mặt với...</h2>
      </div>
      <div class="problem-grid">
        <div class="problem-card">
          <div class="problem-icon-wrap">⏰</div>
          <h3>3-4 giờ mỗi lớp</h3>
          <p>Một lớp 35 HS × 8-12 môn × NL/PC = vài trăm câu nhận xét phải viết, hoặc nhập tay khá vất vả và mệt!</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon-wrap">🔁</div>
          <h3>Câu chữ lặp đi lặp lại</h3>
          <p>Càng viết về cuối càng khó nghĩ ra cách diễn đạt khác — dễ trùng giữa các HS, khó tránh.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon-wrap">😓</div>
          <h3>Áp lực thời gian</h3>
          <p>Vừa hoàn tất sổ điểm, vừa coi thi, vừa họp PHHS — đầu óc không còn sức cho nhận xét.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== VIDEO HƯỚNG DẪN (V2.1: lên trước Features để GV thấy ngay) ============== -->
  <section id="video" class="video-section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Video hướng dẫn</span>
        <h2 class="text-balance">Xem chi tiết từng tính năng</h2>
        <p class="text-pretty">Mỗi video dưới 3 phút — vừa đủ để thầy cô tự làm theo mà không cần thành thạo CNTT.</p>
      </div>

      <!-- Video grid -->
      <div class="video-grid">
        {videos.map(v => (
          <article class="video-card">
            <div class="video-player">
              {v.youtubeId ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}?rel=0&modestbranding=1`}
                  title={v.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <div class="video-placeholder">
                  <div class="video-play-icon">▶</div>
                  <div class="video-placeholder-text">Coming soon</div>
                </div>
              )}
              <div class="video-duration">{v.duration}</div>
            </div>
            <div class="video-meta">
              <span class="video-tag">{v.tag}</span>
              <h4>{v.title}</h4>
              <div class="video-info">
                <span>⏱ {v.duration}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== FEATURES ============== -->
  <section id="tinh-nang" class="section-dark features-section-dark">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Giải pháp</span>
        <h2 class="text-balance">AI hỗ trợ tạo nhận xét — giáo viên vẫn là người quyết định cuối cùng</h2>
        <p class="text-pretty">Extension đọc bảng điểm Vnedu, sinh nhận xét, GV xem trước rồi áp dụng. Không thay thế GV — chỉ tăng tốc 30 lần.</p>
      </div>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature" style={`--feat-accent: ${f.accent}; --feat-accent-bg: ${f.accentBg};`}>
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== INSTALL STEPS ============== -->
  <section id="cai-dat" class="section-canvas">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Cài đặt</span>
        <h2 class="text-balance">3 bước · ~30 giây · không cần biết kỹ thuật</h2>
        <p class="text-pretty">
          Đã có mặt trên <strong>Chrome Web Store</strong> — cài 1 click, tự cập nhật khi có bản mới, không cần làm gì thêm.
        </p>
      </div>

      <div class="steps">
        <div class="step">
          <h3>Bấm "Cài cho Chrome"</h3>
          <p>Nút bên dưới mở Chrome Web Store. Tại đó bấm <kbd>Thêm vào Chrome</kbd> → <kbd>Thêm tiện ích</kbd>. Xong, có icon trên thanh công cụ.</p>
        </div>
        <div class="step">
          <h3>Mở Vnedu, vào Sổ nhận xét</h3>
          <p>Đăng nhập Vnedu như bình thường. Vào <kbd>Sổ điểm → Sổ nhận xét</kbd>, chọn lớp, môn, học kỳ. <strong>Sidebar tự xuất hiện bên phải.</strong></p>
        </div>
        <div class="step">
          <h3>Đăng ký mã & bắt đầu</h3>
          <p>Lần đầu, sidebar hướng dẫn đăng ký mã & kích hoạt ngay trong app. Từ lần sau, mở Vnedu là dùng được ngay.</p>
        </div>
      </div>

      <div style="text-align: center; margin-top: 56px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href={cwsUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          🌐 Cài đặt qua Chrome Web Store
        </a>
        <a href={installGuideUrl} class="btn btn-ghost btn-lg">
          📖 Hướng dẫn chi tiết
        </a>
      </div>
    </div>
  </section>

  <!-- ============== JOIN COMMUNITY ============== -->
  <section id="cong-dong">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">💬 Cộng đồng</span>
        <h2 class="text-balance">Tham gia nhóm <span class="highlight">Hỗ trợ Công nghệ số</span></h2>
        <p class="text-pretty">
          Cộng đồng giáo viên tiểu học đang dùng Sổ nhận xét - AI và các công cụ công nghệ giáo dục. Hỗ trợ trực tiếp về kỹ thuật và công nghệ · trao đổi kinh nghiệm · cập nhật phiên bản mới sớm nhất.
        </p>
      </div>

      <div class="community-card">
        <div class="community-info">
          <div class="community-badge">
            <svg class="community-zalo-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path fill="currentColor" d="M12 2C6.477 2 2 5.94 2 10.8c0 2.78 1.46 5.25 3.74 6.87-.16.62-.5 1.5-1.1 2.34-.13.18-.04.43.18.45.05.01.1.01.16.01 1.34 0 3-.74 4.16-1.42.93.21 1.9.33 2.86.33 5.52 0 10-3.94 10-8.8S17.52 2 12 2z"/>
            </svg>
            <span>Nhóm Zalo · Mở để tham gia</span>
          </div>
          <h3>Nhóm Hỗ trợ Công nghệ số</h3>
          <p class="community-tagline">
