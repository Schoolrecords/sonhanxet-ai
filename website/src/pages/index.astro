---
import BaseLayout from '../layouts/BaseLayout.astro';

// 06/11/2026: viết lại cho khớp bản 6.1.3 — tự kích hoạt bằng QR (SePay), giá 50.000đ/năm học,
// dùng thử 1 môn + 1 lớp. Không ghi số phiên bản trên trang (Store tự cập nhật).
const cwsUrl = 'https://chromewebstore.google.com/detail/sổ-nhận-xét-ai/hhiipgifeplegcejhpdmdbnbabjikllh';
const installGuideUrl = '/cai-dat';
const supportPhone = '0913031073';

// ====== VIDEO HƯỚNG DẪN ======
const featuredVideo = {
  title: "Bắt đầu trong 90 giây — từ cài đặt đến nhận xét đầu tiên",
  duration: "1:30",
  youtubeId: "GXprh9sotv0",
};
const videos = [
  { title: "Tạo nhận xét môn học cho cả lớp", duration: "2:15", tag: "Nhận xét môn", youtubeId: "sUTybnmawvM" },
  { title: "Tạo nhận xét Năng lực và Phẩm chất", duration: "3:00", tag: "Nhận xét NL, PC", youtubeId: "APakefrddc8" },
];

// ====== BIỂU TƯỢNG NÉT ĐƠN (thay biểu tượng cảm xúc) ======
const I = {
  clock: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2"/>',
  repeat: '<path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/><path d="M9 7h6"/>',
  star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  send: '<path d="M4 12h12"/><path d="M12 6l6 6-6 6"/><path d="M20 4v16"/>',
  check: '<path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14.6-4.5L4 8"/><path d="M4 3v5h5"/><path d="M4 13a8 8 0 0 0 14.6 4.5L20 16"/><path d="M20 21v-5h-5"/>',
  laptop: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
};

// ====== TÍNH NĂNG ======
const features = [
  { icon: I.book, title: "Nhận xét môn học",
    desc: "Đủ các môn và hoạt động: Tiếng Việt, Toán, Tự nhiên và Xã hội, Khoa học, Lịch sử và Địa lí, Đạo đức, Tin học, Tiếng Anh, Giáo dục thể chất, Âm nhạc, Mĩ thuật, Hoạt động trải nghiệm. Câu chữ đa dạng, hạn chế trùng lặp giữa các em." },
  { icon: I.star, title: "Nhận xét Năng lực, Phẩm chất",
    desc: "Tự gợi ý mức và lời nhận xét Năng lực, Phẩm chất dựa trên kết quả học tập. Thầy cô bấm vào mức để đổi khi cần." },
  { icon: I.send, title: "Đưa thẳng vào vnEdu",
    desc: "Xem trước toàn bộ nhận xét trong khung bên phải. Bấm “Áp dụng vào Vnedu” là chữ vào đúng ô của từng em, rồi thầy cô bấm Lưu của vnEdu." },
  { icon: I.check, title: "Theo Thông tư 27",
    desc: "Lời nhận xét nêu rõ mức độ đạt được, dùng từ phù hợp lứa tuổi tiểu học, đúng tinh thần Thông tư 27/2020/TT-BGDĐT." },
  { icon: I.lock, title: "Dữ liệu học sinh ở lại trên máy",
    desc: "Tên, điểm, nhận xét của học sinh không gửi đi đâu. Tiện ích chạy ngay trên trang vnEdu, không cần cài thêm phần mềm." },
  { icon: I.refresh, title: "Tự cập nhật",
    desc: "Khi vnEdu đổi giao diện, bản sửa được đưa lên Chrome Web Store và máy thầy cô tự cập nhật, không phải cài lại." },
];

// ====== HỎI ĐÁP ======
const faqs = [
  {
    q: "Dùng thử thế nào? Bao giờ mới phải trả tiền?",
    a: "Cài xong là dùng thử được ngay, miễn phí, với 1 môn của 1 lớp (môn và lớp đầu tiên thầy cô dùng). Khi muốn dùng các môn khác, các lớp khác hoặc phần Năng lực, Phẩm chất thì mới cần đăng ký bản quyền 50.000đ/năm học.",
  },
  {
    q: "Thanh toán thế nào? Có phải gọi điện hay nhắn tin cho ai không?",
    a: "Không cần. Trong tiện ích bấm biểu tượng bánh răng, nhập Họ tên và Số điện thoại rồi bấm “Bắt đầu kích hoạt”. Tiện ích hiện mã QR, thầy cô mở app ngân hàng quét mã — số tiền và nội dung đã có sẵn, không phải gõ gì — rồi xác nhận chuyển. Khoảng 1 phút sau tiện ích tự mở khoá.",
  },
  {
    q: "Đã chuyển khoản mà chưa thấy mở khoá?",
    a: "Thường chỉ dưới 1 phút. Thầy cô cứ để nguyên khung đang chờ, tiện ích tự kiểm tra. Nếu sau 30 phút vẫn chưa mở khoá, nhắn Zalo 0913031073 kèm ảnh biên lai chuyển khoản để được mở tay.",
  },
  {
    q: "Bản quyền dùng đến bao giờ? Dùng được mấy máy?",
    a: "Đến hết ngày 31/8 của năm học. Dùng được trên mọi máy của chính thầy cô (máy ở trường, máy ở nhà). Đồng nghiệp muốn dùng xin đăng ký bằng số điện thoại riêng; một số điện thoại dùng trên quá nhiều máy sẽ bị khoá.",
  },
  {
    q: "Đổi máy hoặc cài lại Windows thì có phải trả lại tiền không?",
    a: "Không. Trên máy mới, cài tiện ích, bấm biểu tượng bánh răng, chọn “Đã có bản quyền? Đăng nhập trên máy khác”, nhập Số điện thoại và mã đăng nhập. Mã đăng nhập xem ở mục Bản quyền trên máy cũ; quên mã thì nhắn Zalo 0913031073.",
  },
  {
    q: "Dữ liệu học sinh có bị gửi đi đâu không?",
    a: "Không. Tên, điểm, nhận xét của học sinh chỉ nằm trên trình duyệt của thầy cô. Máy chủ bản quyền chỉ lưu Họ tên, Số điện thoại của thầy cô và trạng thái bản quyền.",
  },
  {
    q: "Có sửa được lời nhận xét không?",
    a: "Được. Có 2 chỗ sửa: (1) ngay trong khung xem trước của tiện ích, trước khi áp dụng; (2) sau khi đã áp dụng, sửa trực tiếp trong ô của vnEdu như bình thường rồi bấm Lưu. Tiện ích không bao giờ tự bấm Lưu thay thầy cô.",
  },
  {
    q: "Không thấy khung Sổ nhận xét - AI trên vnEdu?",
    a: "Kiểm tra 3 việc: (1) đang dùng Chrome trên máy tính, không phải điện thoại; (2) đang ở đúng trang Sổ nhận xét của vnEdu; (3) bấm F5 tải lại trang. Nếu đổi lớp, đổi môn mà khung chưa đổi theo, bấm nút “Cập nhật dữ liệu từ Vnedu” ở đầu khung.",
  },
];
---

<BaseLayout title="Sổ nhận xét - AI · Trợ lý tạo nhận xét cho giáo viên tiểu học trên vnEdu">

  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Cho giáo viên tiểu học dùng vnEdu</span>
        <h1 class="text-balance">
          Nhận xét <span class="highlight">cả lớp</span>,<br />
          mỗi môn chỉ <span class="underline-gold">vài phút</span>
        </h1>
        <p class="hero-sub text-pretty">
          Tiện ích đọc kết quả học tập ngay trên vnEdu, viết sẵn lời nhận xét cho từng em theo Thông tư 27.
          Thầy cô xem lại, sửa nếu cần, rồi bấm Lưu như mọi khi.
        </p>
        <div class="hero-cta">
          <a href={cwsUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cài cho Chrome</a>
          <a href="#bat-dau" class="btn btn-ghost btn-lg">Xem 4 bước bắt đầu</a>
        </div>
        <p class="hero-price">
          <strong>Dùng thử miễn phí</strong> 1 môn · Bản đầy đủ <strong>50.000đ/năm học</strong>, dùng trên mọi máy của thầy cô
        </p>
      </div>

      <div class="hero-visual">
        <div class="hero-video-frame">
          <div class="hero-video-bar">
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <div class="hero-video-bar-label">
              <span class="hero-video-play">▶</span>
              Video hướng dẫn · {featuredVideo.duration}
            </div>
          </div>
          <div class="video-player hero-video-player">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${featuredVideo.youtubeId}?rel=0&modestbranding=1`}
              title={featuredVideo.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== BẮT ĐẦU TRONG 4 BƯỚC ============== -->
  <section id="bat-dau" class="section-canvas start-section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Bắt đầu</span>
        <h2 class="text-balance">Làm theo 4 bước là dùng được ngay</h2>
        <p class="text-pretty">Lần đầu mất khoảng 5 phút. Từ lần sau, mở vnEdu là dùng.</p>
      </div>

      <div class="prep">
        <div class="prep-title">Cần chuẩn bị</div>
        <div class="prep-items">
          <div class="prep-item"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.laptop} /><span><strong>Máy tính</strong> có trình duyệt Chrome</span></div>
          <div class="prep-item"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.user} /><span><strong>Tài khoản vnEdu</strong> giáo viên</span></div>
          <div class="prep-item"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.phone} /><span><strong>App ngân hàng</strong> trên điện thoại (khi mua bản quyền)</span></div>
        </div>
      </div>

      <ol class="start-steps">
        <li class="start-step">
          <div class="start-num">1</div>
          <div class="start-body">
            <h3>Cài tiện ích</h3>
            <p>Bấm nút <strong>Cài cho Chrome</strong>. Trang Chrome Web Store mở ra, bấm <kbd>Thêm vào Chrome</kbd> rồi <kbd>Thêm tiện ích</kbd>.</p>
            <a href={installGuideUrl} class="start-link">Xem ảnh từng bước cài →</a>
          </div>
          <div class="start-mock" aria-hidden="true">
            <div class="mock-store">
              <img src="/logo-app.png" alt="" width="36" height="36" />
              <div class="mock-store-name">Sổ nhận xét - AI</div>
              <span class="mock-btn mock-btn-store">Thêm vào Chrome</span>
            </div>
          </div>
        </li>

        <li class="start-step">
          <div class="start-num">2</div>
          <div class="start-body">
            <h3>Mở Sổ nhận xét trên vnEdu</h3>
            <p>Đăng nhập vnEdu như mọi khi, vào <kbd>Sổ điểm</kbd> rồi <kbd>Sổ nhận xét</kbd>, chọn lớp, môn, học kỳ. Khung <strong>Sổ nhận xét - AI</strong> tự hiện ở bên phải.</p>
          </div>
          <div class="start-mock" aria-hidden="true">
            <div class="mock-page">
              <div class="mock-page-main">
                <div class="mock-line w80"></div><div class="mock-line w60"></div><div class="mock-line w70"></div><div class="mock-line w50"></div>
              </div>
              <div class="mock-page-side">
                <div class="mock-side-head">Sổ nhận xét - AI</div>
                <div class="mock-line w80 light"></div><div class="mock-line w60 light"></div>
              </div>
            </div>
          </div>
        </li>

        <li class="start-step">
          <div class="start-num">3</div>
          <div class="start-body">
            <h3>Tạo nhận xét, xem lại, Lưu</h3>
            <p>Bấm <strong>Tạo nhận xét</strong>. Đọc qua, sửa em nào cần sửa. Bấm <strong>Áp dụng vào Vnedu</strong>, rồi bấm nút <kbd>Lưu</kbd> của vnEdu.</p>
            <p class="start-note">Tiện ích không tự bấm Lưu, thầy cô luôn là người quyết định.</p>
          </div>
          <div class="start-mock" aria-hidden="true">
            <div class="mock-side">
              <span class="mock-btn">Tạo nhận xét</span>
              <div class="mock-cmt"><b>Nguyễn An</b> Đọc to, rõ ràng; viết đúng chính tả…</div>
              <div class="mock-cmt"><b>Lê Bình</b> Thực hiện thành thạo các phép tính…</div>
              <span class="mock-btn">Áp dụng vào Vnedu</span>
            </div>
          </div>
        </li>

        <li class="start-step">
          <div class="start-num">4</div>
          <div class="start-body">
            <h3>Mở khoá các môn: quét QR</h3>
            <p>Dùng thử miễn phí 1 môn. Muốn dùng hết: bấm biểu tượng bánh răng, nhập <strong>Họ tên</strong> và <strong>Số điện thoại</strong>, bấm <strong>Bắt đầu kích hoạt</strong>. Mở app ngân hàng quét mã QR, xác nhận chuyển.</p>
            <p class="start-note">Số tiền và nội dung đã có sẵn trong mã. Khoảng 1 phút sau tiện ích tự mở khoá, không cần gọi ai.</p>
          </div>
          <div class="start-mock" aria-hidden="true">
            <div class="mock-side mock-qr-card">
              <svg class="mock-qr" viewBox="0 0 21 21" shape-rendering="crispEdges">
                <rect width="21" height="21" fill="#fff"/>
                <path fill="#14244F" d="M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z"/>
                <path fill="#fff" d="M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z"/>
                <path fill="#14244F" d="M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2zM9 1h1v2H9zM11 2h2v1h-2zM8 4h2v2H8zM12 5h1v3h-1zM9 8h2v1H9zM1 9h3v1H1zM5 8h2v2H5zM14 9h2v1h-2zM17 8h3v1h-3zM8 10h1v3H8zM10 11h3v1h-3zM15 11h1v2h-1zM18 11h2v2h-2zM9 14h2v2H9zM12 13h2v1h-2zM14 15h3v1h-3zM18 15h2v1h-2zM10 17h1v3h-1zM12 18h3v1h-3zM16 18h1v2h-1zM19 18h1v3h-1zM8 19h1v1H8z"/>
              </svg>
              <div class="mock-wait"><span class="mock-spin"></span>Đang chờ ngân hàng báo có…</div>
            </div>
          </div>
        </li>
      </ol>

      <div class="start-cta">
        <a href={cwsUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cài cho Chrome</a>
        <a href={installGuideUrl} class="btn btn-ghost btn-lg">Hướng dẫn chi tiết có ảnh</a>
      </div>
    </div>
  </section>

  <!-- ============== GIÁ ============== -->
  <section id="gia">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Giá</span>
        <h2 class="text-balance">Một mức giá, dùng cả năm học</h2>
      </div>
      <div class="price-wrap">
        <div class="price-col price-free">
          <h3>Dùng thử</h3>
          <div class="price-big">0đ</div>
          <ul>
            <li>1 môn của 1 lớp</li>
            <li>Đủ để xem chất lượng lời nhận xét</li>
            <li>Không cần đăng ký</li>
          </ul>
        </div>
        <div class="price-col price-full">
          <h3>Bản đầy đủ</h3>
          <div class="price-big">50.000đ<span>/năm học</span></div>
          <ul>
            <li>Tất cả các môn, tất cả các lớp</li>
            <li>Nhận xét Năng lực, Phẩm chất</li>
            <li>Dùng trên mọi máy của thầy cô</li>
            <li>Hiệu lực đến hết 31/8</li>
            <li>Quét QR, tự mở khoá sau khoảng 1 phút</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== VẤN ĐỀ ============== -->
  <section class="section-canvas problem-section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Vì sao cần</span>
        <h2 class="text-balance">Cuối học kỳ, thầy cô thường gặp 3 khó khăn</h2>
      </div>
      <div class="problem-grid">
        <div class="problem-card">
          <div class="problem-icon-wrap"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={I.clock} /></div>
          <h3>Mất nhiều thời gian</h3>
          <p>Lớp đông học sinh, nhiều môn và nhiều nội dung đánh giá, viết tay từng lời nhận xét rất vất vả.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon-wrap"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={I.repeat} /></div>
          <h3>Dễ lặp ý, trùng câu</h3>
          <p>Viết nhiều nhận xét cùng lúc thì khó diễn đạt phong phú và sát với từng học sinh.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon-wrap"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={I.calendar} /></div>
          <h3>Áp lực tiến độ cuối kỳ</h3>
          <p>Cuối kỳ dồn nhiều việc: điểm số, hồ sơ, kiểm tra, họp phụ huynh… nên rất cần một công cụ nhẹ nhàng, đỡ việc.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== TÍNH NĂNG ============== -->
  <section id="tinh-nang" class="section-dark features-section-dark">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Tính năng</span>
        <h2 class="text-balance">Tiện ích viết sẵn, giáo viên quyết định</h2>
        <p class="text-pretty">Tiện ích đọc kết quả trên vnEdu và viết sẵn lời nhận xét. Thầy cô xem, sửa, rồi mới lưu.</p>
      </div>
      <div class="features-grid">
        {features.map(f => (
          <div class="feature">
