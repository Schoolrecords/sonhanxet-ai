{
  "manifest_version": 3,
  "name": "Sổ nhận xét - AI",
  "version": "4.0.0",
  "description": "Sổ nhận xét - AI v4.0 · Sinh nhận xét môn học + NL/PC tự động cho GV tiểu học trên Vnedu theo Thông tư 27/2020. Phong cách câu trung tính, đúng kỳ/mức điểm, không bám bộ sách.",
  "author": "Phát triển bởi giáo viên cho giáo viên",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "*://*.vnedu.vn/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.vnedu.vn/*"],
      "js": [
        "engine/engine.js",
        "content/vnedu-adapter.js",
        "content/content-script.js"
      ],
      "css": ["content/sidebar-inject.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/sidebar.html",
        "sidebar/sidebar.css",
        "sidebar/sidebar.js",
        "engine/engine.js",
        "engine/data/*.json",
        "license/client.js",
        "license/qr.png"
      ],
      "matches": ["*://*.vnedu.vn/*"]
    }
  ],

  "action": {
    "default_title": "Sổ nhận xét - AI · Click để mở/đóng bảng bên",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
